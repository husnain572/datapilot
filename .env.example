# Copy this file to .env and fill in real values:   cp .env.example .env
# .env is ignored by Git. This example file is committed, so never put real keys here.

# local or production
APP_ENV=local

# Where uploaded datasets and results are stored
DATA_DIR=data

# Address the Streamlit frontend uses to reach the FastAPI backend
BACKEND_URL=http://127.0.0.1:8000

# --- AI provider (backend only; the frontend never reads this file) ---
# openai_compatible: Groq (free) using the AI_* settings below.
# openai: OpenAI's official SDK and Responses API, using the OPENAI_* settings. This is PAID.
AI_PROVIDER=openai_compatible

# Primary: Groq's free tier. Create a key at https://console.groq.com/keys (no payment needed).
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
# "prompt" describes the JSON format in words. "schema" uses Groq's structured outputs (untested here).
AI_STRUCTURED_MODE=prompt
# low, medium, or high. Lower uses fewer of the free daily tokens. Blank for providers without it.
AI_REASONING_EFFORT=low
AI_TIMEOUT_SECONDS=90
AI_MAX_ATTEMPTS=3
AI_MAX_COMPLETION_TOKENS=8192
# Stay below Groq's free limits for this model (about 1,000 requests and 200,000 tokens a day).
# Check your exact limits at https://console.groq.com/settings/limits
AI_DAILY_REQUEST_LIMIT=900
AI_DAILY_TOKEN_LIMIT=180000

# OpenAI (used only when AI_PROVIDER=openai). Paid per token; set a spending limit in OpenAI too.
# Models and prices: https://developers.openai.com/api/docs/models
OPENAI_API_KEY=
# For example gpt-6-luna (cheapest) or gpt-6-astra (OpenAI's flagship, much more expensive).
OPENAI_MODEL=
# Optional: a reasoning effort the chosen model supports, such as low. Blank uses OpenAI's default.
OPENAI_REASONING_EFFORT=
OPENAI_MAX_OUTPUT_TOKENS=8192
# Daily caps, which also cap daily spending.
OPENAI_DAILY_REQUEST_LIMIT=150
OPENAI_DAILY_TOKEN_LIMIT=300000

# Optional fallback: Google Gemini, used only if a key is set and Groq is busy or out of quota.
# Create a key in Google AI Studio. Set the limits from your account's limits page there.
AI_FALLBACK_API_KEY=
AI_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_FALLBACK_MODEL=gemini-3.8-flash
AI_FALLBACK_STRUCTURED_MODE=prompt
AI_FALLBACK_REASONING_EFFORT=
AI_FALLBACK_DAILY_REQUEST_LIMIT=200
AI_FALLBACK_DAILY_TOKEN_LIMIT=500000

# Used to estimate "analyses left today" from the remaining token budget.
AI_TOKENS_PER_ANALYSIS_ESTIMATE=12000

# Other OpenAI-compatible providers also work by changing the primary settings, for example:
# Vultr Serverless Inference (paid per token):
#   AI_BASE_URL=https://api.vultrinference.com/v1, AI_MODEL=glm-5.3, AI_STRUCTURED_MODE=schema, AI_REASONING_EFFORT=
# OpenRouter free models: AI_BASE_URL=https://openrouter.ai/api/v1, AI_MODEL=nvidia/nemotron-3.5-super-vl:free

# --- Secure sandbox (the executor service, only on the server) ---
EXECUTOR_URL=http://127.0.0.1:8100
EXECUTOR_TOKEN=

# Hourly limits for each visitor. The site has no login.
VISITOR_ANALYSES_PER_HOUR=15
VISITOR_LAB_RUNS_PER_HOUR=3

# To use Vultr Serverless Inference instead (paid per token), use your Vultr key and:
# AI_BASE_URL=https://api.vultrinference.com/v1
# AI_MODEL=glm-5.3
# AI_STRUCTURED_MODE=schema
