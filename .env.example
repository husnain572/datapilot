# Copy this file to .env and fill in real values:   cp .env.example .env
# .env is ignored by Git. This example file is committed, so never put real keys here.

# local or production
APP_ENV=local

# Where uploaded datasets and results are stored
DATA_DIR=data

# Address the Streamlit frontend uses to reach the FastAPI backend
BACKEND_URL=http://127.0.0.1:8000

# --- Vultr Serverless Inference (used from Phase 4) ---
# Key from your inference subscription, not your Vultr account API key
VULTR_SERVERLESS_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
# Provisional. Phase 4 compares models and picks one using real results.
VULTR_INFERENCE_MODEL=glm-5.3
